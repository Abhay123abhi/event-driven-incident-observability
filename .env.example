POSTGRES_PASSWORD=choose-a-local-password
GRAFANA_ADMIN_PASSWORD=choose-a-grafana-password
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

# Optional AI investigation profile. Leave disabled for the original deterministic platform.
AI_INVESTIGATION_ENABLED=false
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AI_RETRIEVAL_TOP_K=5

# Start the email profile to run the consumer; this switch controls sending.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM=
ALERT_EMAIL_TO=
SMTP_AUTH=true
SMTP_STARTTLS=true

INCIDENT_MAXIMUM_PAGE_SIZE=100
INCIDENT_RESOLVED_RETENTION_DAYS=30
INCIDENT_OUTBOX_RETENTION_DAYS=7
TRACING_ENABLED=true
